{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "site": "pedidos-joey",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".gitignore",
        "firebase-debug.log",
        "**/node_modules/**",
        "*.bat",
        "*.exe",
        "index.html",
        "serviceAccount*.json",
        "**/serviceAccount*.json",
        ".env",
        ".env.*",
        "*.key",
        "*.pem",
        "functions/**",
        "*.backup*.html",
        "gestao-joey.backup*.html",
        "migrar*.js",
        "atualizar*.js",
        "trocar*.js",
        "limpar*.js",
        "gerar*.js",
        "ativar*.js",
        "backup*.js",
        "buscar*.js",
        "comparar*.js",
        "corrigir*.js",
        "criar*.js",
        "deletar*.js",
        "desativar*.js",
        "descobrir*.js",
        "estrutura*.js",
        "inspecionar*.js",
        "listar*.js",
        "monitor*.js",
        "pegar*.js",
        "redeploy*.js",
        "renomear*.js",
        "seed*.js"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/cardapio.html",
          "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
        },
        {
          "source": "/**",
          "headers": [
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/emitirNFCe",
          "function": "emitirNFCe",
          "region": "us-central1"
        },
        {
          "source": "/api/cancelarNFCe",
          "function": "cancelarNFCe",
          "region": "us-central1"
        },
        {
          "source": "/garcom",
          "destination": "/garcom.html"
        },
        {
          "source": "/",
          "destination": "/cardapio.html"
        }
      ]
    },
    {
      "site": "pedidos-joey-painel",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".gitignore",
        "firebase-debug.log",
        "**/node_modules/**",
        "*.bat",
        "*.exe",
        "index.html",
        "serviceAccount*.json",
        "**/serviceAccount*.json",
        ".env",
        ".env.*",
        "*.key",
        "*.pem",
        "functions/**",
        "*.backup*.html",
        "gestao-joey.backup*.html",
        "migrar*.js",
        "atualizar*.js",
        "trocar*.js",
        "limpar*.js",
        "gerar*.js",
        "ativar*.js",
        "backup*.js",
        "buscar*.js",
        "comparar*.js",
        "corrigir*.js",
        "criar*.js",
        "deletar*.js",
        "desativar*.js",
        "descobrir*.js",
        "estrutura*.js",
        "inspecionar*.js",
        "listar*.js",
        "monitor*.js",
        "pegar*.js",
        "redeploy*.js",
        "renomear*.js",
        "seed*.js"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/painel.html",
          "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
        },
        {
          "source": "/cardapio.html",
          "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
        },
        {
          "source": "/**",
          "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
        }
      ],
      "rewrites": [
        {
          "source": "/api/emitirNFCe",
          "function": "emitirNFCe",
          "region": "us-central1"
        },
        {
          "source": "/api/cancelarNFCe",
          "function": "cancelarNFCe",
          "region": "us-central1"
        },
        {
          "source": "/garcom",
          "destination": "/garcom.html"
        },
        {
          "source": "/",
          "destination": "/painel.html"
        }
      ]
    },
    {
      "site": "gestaojoey-painel",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".gitignore",
        "firebase-debug.log",
        "**/node_modules/**",
        "*.bat",
        "*.exe",
        "index.html",
        "serviceAccount*.json",
        "**/serviceAccount*.json",
        ".env",
        ".env.*",
        "*.key",
        "*.pem",
        "functions/**",
        "*.backup*.html",
        "gestao-joey.backup*.html",
        "migrar*.js",
        "atualizar*.js",
        "trocar*.js",
        "limpar*.js",
        "gerar*.js",
        "ativar*.js",
        "backup*.js",
        "buscar*.js",
        "comparar*.js",
        "corrigir*.js",
        "criar*.js",
        "deletar*.js",
        "desativar*.js",
        "descobrir*.js",
        "estrutura*.js",
        "inspecionar*.js",
        "listar*.js",
        "monitor*.js",
        "pegar*.js",
        "redeploy*.js",
        "renomear*.js",
        "seed*.js"
      ],
      "headers": [
        { "source": "/painel.html", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}] },
        { "source": "/cardapio.html", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}] },
        { "source": "/gestao-joey.html", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}] },
        { "source": "/**", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}] }
      ],
      "rewrites": [
        { "source": "/pedidos",          "destination": "/painel.html" },
        { "source": "/pedidos/**",       "destination": "/painel.html" },
        { "source": "/gestao",           "destination": "/gestao-joey.html" },
        { "source": "/gestao/**",        "destination": "/gestao-joey.html" },
        { "source": "/garcom",           "destination": "/garcom.html" },
        { "source": "**",                "destination": "/cardapio.html" }
      ]
    }
  ]
}
