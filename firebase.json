{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "site": "pedidos-joey",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".gitignore",
        "firebase-debug.log",
        "**/node_modules/**",
        "*.bat",
        "*.exe",
        "index.html"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/emitirNFCe",
          "function": "emitirNFCe",
          "region": "us-central1"
        },
        {
          "source": "/api/cancelarNFCe",
          "function": "cancelarNFCe",
          "region": "us-central1"
        },
        {
          "source": "/",
          "destination": "/cardapio.html"
        }
      ]
    },
    {
      "site": "pedidos-joey-painel",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".gitignore",
        "firebase-debug.log",
        "**/node_modules/**",
        "*.bat",
        "*.exe",
        "index.html"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/painel.html",
          "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
        }
      ],
      "rewrites": [
        {
          "source": "/api/emitirNFCe",
          "function": "emitirNFCe",
          "region": "us-central1"
        },
        {
          "source": "/api/cancelarNFCe",
          "function": "cancelarNFCe",
          "region": "us-central1"
        },
        {
          "source": "/",
          "destination": "/painel.html"
        }
      ]
    },
    {
      "site": "gestaojoey-painel",
      "public": ".",
      "ignore": [
        "firebase.json", ".firebaserc", ".gitignore",
        "firebase-debug.log", "**/node_modules/**",
        "*.bat", "*.exe", "index.html",
        "serviceAccount*.json", "migrar*.js", "atualizar*.js",
        "trocar*.js", "limpar*.js", "gerar*.js"
      ],
      "headers": [
        { "source": "/painel.html", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}] },
        { "source": "/gestao-joey.html", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}] }
      ],
      "rewrites": [
        { "source": "/pedidos",          "destination": "/painel.html" },
        { "source": "/pedidos/**",       "destination": "/painel.html" },
        { "source": "/gestao",           "destination": "/gestao-joey.html" },
        { "source": "/gestao/**",        "destination": "/gestao-joey.html" },
        { "source": "**",                "destination": "/cardapio.html" }
      ]
    }
  ]
}
