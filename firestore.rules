rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'fred@joey.app.br'
         || request.auth.token.email == 'isabela@joey.app.br');
    }

    function isOwner(slug) {
      return request.auth != null
        && get(/databases/$(database)/documents/clientes/$(slug)).data.authUid == request.auth.uid;
    }

    // MODO SUPORTE (super admin): claim { superAdmin: true } gravado no usuário pelo script
    // gestaojoey-saas/scripts/setSuperAdmin.js. Lê do JWT (request.auth.token) DE PROPÓSITO:
    // get() no Firestore não autoriza operação de `list`, então um isSuperAdmin() baseado em get()
    // deixaria as queries do painel (pedidos, receitas…) falharem em modo suporte.
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    // App Garçom: custom token com claim slug + role (gerado pela function garcomLogin após validar o PIN).
    function isGarcom(slug) {
      return request.auth != null
        && request.auth.token.slug == slug
        && request.auth.token.role == 'garcom';
    }

    match /clientes/{slug} {
      // 'read' cobre get (1 doc) E list/query. A query do login universal
      // (clientes.where('authUid','==',uid)) precisa autorizar via resource.data (dado do PRÓPRIO
      // doc candidato), porque isOwner usa get() e get() NÃO autoriza list. Com resource.data.authUid
      // == uid, o usuário só consegue ler/listar o próprio tenant (query de outro uid → negada).
      allow read:  if isAdmin() || isSuperAdmin() || isOwner(slug)
                   || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow write: if isAdmin() || isSuperAdmin() || isOwner(slug);
    }

    match /clientes/{slug}/config/cardapio       { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/config/catOrdem       { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/config/configuracoes  { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/config/cors           { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/config/loja           { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/config/prodOrdem      { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }

    match /clientes/{slug}/config/{doc} {
      allow read, write: if isAdmin() || isSuperAdmin() || isOwner(slug);
    }

    match /clientes/{slug}/categorias/{id}     { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/adicionais/{id}     { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    match /clientes/{slug}/catalogoStatus/{id} { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }
    // mesas (estado): leitura pública (cardápio/QR); escrita só dono OU garçom (status quo: cardápio
    // QR já gravava best-effort e era owner-only — mantido. O estado da conta é derivado do pedido ativo).
    match /clientes/{slug}/mesas/{id}          { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug); }
    match /clientes/{slug}/recipes/{id}        { allow read: if true; allow write: if isAdmin() || isSuperAdmin() || isOwner(slug); }

    // mesas-config (definições das mesas): garçom lê (mapa de mesas); só dono edita.
    match /clientes/{slug}/mesas-config/{id} {
      allow read: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug);
      allow write: if isAdmin() || isSuperAdmin() || isOwner(slug);
    }

    // fechamentos: o garçom registra ao fechar a conta; dono também.
    match /clientes/{slug}/fechamentos/{id} {
      allow read, write: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug);
    }

    match /clientes/{slug}/pedidos/{id} {
      // LGPD: o cliente anônimo do cardápio SÓ enxerga o PRÓPRIO pedido — carimbado com
      // authUid == uid na criação (cardapio.html). Antes era `auth != null`, que permitia a
      // QUALQUER sessão anônima ler/listar TODOS os pedidos de TODOS os tenants (dump de PII).
      // Staff do tenant (dono/garçom/admin) lê tudo; o entregador lê só os pedidos atribuídos a ele.
      allow read: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug)
                  || (request.auth != null && resource.data.authUid == request.auth.uid)
                  || (request.auth != null
                      && request.auth.token.entregadorId != null
                      && request.auth.token.tenant == slug          // Bloco 2: entregador só lê o PRÓPRIO tenant
                      && resource.data.entregadorId == request.auth.token.entregadorId);
      // Anônimo só cria pedido carimbado como SEU (authUid == uid); staff cria livre; bot usa Admin SDK.
      allow create: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug)
                    || (request.auth != null && request.resource.data.authUid == request.auth.uid);
      // Entregador marca "Entreguei" SÓ no pedido dele, do PRÓPRIO tenant (token.tenant == slug):
      // update restrito a status→'finalizado' (+ entregueEm). Staff atualiza/deleta livre.
      allow update: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug)
                    || (request.auth != null
                        && request.auth.token.entregadorId is string
                        && request.auth.token.tenant == slug
                        && request.auth.token.entregadorId == resource.data.entregadorId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'entregueEm'])
                        && request.resource.data.status == 'finalizado');
      allow delete: if isAdmin() || isSuperAdmin() || isOwner(slug) || isGarcom(slug);
    }

    match /clientes/{slug}/carrinhos/{id} {
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow read, delete: if isAdmin() || isSuperAdmin() || isOwner(slug);
    }

    match /clientes/{slug}/config/contador {
      allow read, update: if request.auth != null;
    }

    // Jogo da cobrinha (cardápio Joey) — ranking mensal. Escrita ANÔNIMA permitida SÓ nesta
    // collection isolada, com validação dos campos + TETO DE SCORE (anti-trapaça). Leitura pública
    // (leaderboard). Aditiva — NÃO afrouxa as demais regras (que seguem isAdmin/isOwner).
    match /clientes/joey/ranking_cobrinha/{doc} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'score', 'mesAno', 'criadoEm'])
        && request.resource.data.score is int
        && request.resource.data.score > 0 && request.resource.data.score <= 500
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
        && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20
        && request.resource.data.mesAno is string && request.resource.data.mesAno.size() == 7;
      allow delete: if false;
    }

    // (Bloco 2) A regra do entregador foi UNIFICADA no bloco /clientes/{slug}/pedidos acima
    // (read + update) com binding token.tenant == slug — não é mais hardcoded em joey.

    match /clientes/{slug}/{document=**} {
      allow read, write: if isAdmin() || isSuperAdmin() || isOwner(slug);
    }

    // PIN do App Garçom — privado. Nenhum acesso de client (só Admin SDK via Cloud Functions).
    match /garcomSecrets/{slug} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }

    // Custos de IA (root: custos/anthropic_{AAAAMM}) — só as Cloud Functions (Admin SDK) escrevem,
    // acumulando via FieldValue.increment. NENHUM client escreve; admin pode ler (card de custos).
    // Antes caía no default-deny final; explícito aqui por clareza + defesa em profundidade.
    match /custos/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // config/planos (público: a landing lê os preços) — write só admin. Demais config root idem.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Trilha de auditoria do MODO SUPORTE: toda escrita que um super admin faz no painel de um
    // cliente registra uma linha aqui (painel.html a grava). Sem esta regra a gravação cairia no
    // default-deny do fim e a auditoria falharia calada.
    // IMUTÁVEL de propósito: só create — nem o próprio super admin edita ou apaga a trilha.
    // As validações impedem o autor de se passar por outro uid ou de carimbar outro tenant.
    match /auditoria/{tenant}/acoes/{id} {
      allow read:   if isAdmin() || isSuperAdmin();
      allow create: if isSuperAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.tenantAlvo == tenant;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
